# 复制为 backend/.env 后填写。密钥只放在本机 .env，不要写进网页、截图、压缩包或 Git。

# 智能体与多模态：DeepSeek 官方 OpenAI 兼容接口。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
VISION_MODEL=deepseek-flash

# 为了稳定执行函数工具，比赛演示默认关闭思考模式；可选 none / low / high / max。
LLM_REASONING_EFFORT=none

# 语义向量：本项目使用独立的兼容嵌入服务，不使用聊天模型生成向量。
# 推荐阿里云百炼 text-embedding-v4（OpenAI兼容接口），也可换成其他兼容服务。
# 百炼北京地域示例：https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_PROVIDER=dashscope
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10

# 默认只监听本机，避免未授权的外部访问。
APP_HOST=127.0.0.1
APP_PORT=8000

# 可选：不填时使用项目内默认路径。
CHROMA_PATH=
KNOWLEDGE_MANIFEST=
